# Copy to .env.local and fill in. Never commit .env.local.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time and are therefore
# NOT secret. That is correct for these two: the Supabase anon key is designed to be public,
# and every table is protected by RLS (doc/03-data-model-supabase.md). If a table is ever
# readable with only the anon key, the bug is a missing RLS policy, not a leaked key.
#
# The service_role key must NEVER appear in this file or anywhere in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
